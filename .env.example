DATABASE_URL=""
AUTH_SECRET=""
NEXTAUTH_URL=""
DATABASE_URL_TEST=""

# Shared secrets the photobooth service presents to /api/internal/v1/*.
# Comma-separated so a secret can be rotated without downtime; each at least
# 32 characters. Generate with: openssl rand -hex 32
PHOTOBOOTH_API_SECRETS=""

# Public address of the photobooth service, for the QR on order pages.
# Unset: no QR is shown.
PHOTOBOOTH_URL=""
# Signs the QR link on the tracking page so it opens the photos directly.
# Same value as the photobooth's NUXT_CLAIM_LINK_SECRET.
PHOTOBOOTH_CLAIM_LINK_SECRET=""
