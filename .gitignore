# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the example so Vercel/collaborators know which vars are needed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skill mirrors — regenerated by `prisma skills sync` on postinstall
/.agents/
/.cursor/
/.devin/
/.claude/skills/

# local working docs (not needed to build or deploy)
/prompts/
/claude-artifacts/

# third-party HTML templates used only as design reference (~26 MB, own licenses)
/food-bar-gh-pages/
/vegefoods-1.0.0/

DEPLOY.md