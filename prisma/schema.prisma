// use prisma-8

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  @@type("pg/text@1")
  ADMIN = "ADMIN"
  KASIR = "KASIR"
  DAPUR = "DAPUR"
}

enum ProductPrepType {
  @@type("pg/text@1")
  READY_TO_SERVE = "READY_TO_SERVE"
  NEEDS_PREP = "NEEDS_PREP"
}

enum OrderChannel {
  @@type("pg/text@1")
  PREORDER = "PREORDER"
  ONSITE = "ONSITE"
}

enum OrderStatus {
  @@type("pg/text@1")
  CONFIRMED = "CONFIRMED"
  IN_QUEUE = "IN_QUEUE"
  IN_PROGRESS = "IN_PROGRESS"
  READY = "READY"
  DONE = "DONE"
  CANCELLED = "CANCELLED"
}

enum PaymentStatus {
  @@type("pg/text@1")
  UNPAID = "UNPAID"
  PAID = "PAID"
}

enum PaymentMethod {
  @@type("pg/text@1")
  CASH = "CASH"
  QRIS = "QRIS"
}

// Tempat pesanan preorder diserahkan. OTHER wajib disertai detail lokasi
// (`Order.handoverDetail`) dan baru diproses setelah dicek pengurus
// (`Order.locationReviewedAt`).
enum HandoverLocation {
  @@type("pg/text@1")
  CAMPUS_B = "CAMPUS_B"
  CAMPUS_C = "CAMPUS_C"
  MARKET_DAY = "MARKET_DAY"
  OTHER = "OTHER"
}

enum StoredImageKind {
  @@type("pg/text@1")
  QRIS = "QRIS"
  PAYMENT_PROOF = "PAYMENT_PROOF"
}

// Layanan lain yang boleh menagih ke nota pesanan (BPB-098, keputusan K-05).
enum ChargeSource {
  @@type("pg/text@1")
  PHOTOBOOTH = "PHOTOBOOTH"
}

enum StockReason {
  @@type("pg/text@1")
  INITIAL_STOCK = "INITIAL_STOCK"
  ORDER_CONFIRMED = "ORDER_CONFIRMED"
  ORDER_CANCELLED = "ORDER_CANCELLED"
  MANUAL_ADJUST = "MANUAL_ADJUST"
  WASTE = "WASTE"
}

// ==========================================
// MODELS
// ==========================================

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  role           UserRole
  // isActive menggantikan penghapusan akun. Pengurus berganti tiap Market Day,
  // tapi barisnya tidak bisa dihapus begitu namanya menempel di pesanan atau
  // pergerakan stok — FK-nya menolak, dan riwayat yang kehilangan nama
  // penanganannya jadi tidak bisa diaudit. Akun yang dimatikan tetap terbaca di
  // riwayat, tapi ditolak saat login.
  isActive       Boolean         @default(true)
  // mustChangePassword menandai akun yang masih memakai password awal buatan
  // script. Password awalnya sengaja mudah (<nama>123) supaya bisa dibagikan
  // lisan ke delapan orang, dan itu berarti setiap anggota tim bisa menebak
  // password anggota lain. Penanda ini yang memunculkan peringatan di panel
  // sampai orangnya menggantinya sendiri.
  mustChangePassword Boolean     @default(false)
  createdAt      DateTime        @default(now())
  handledOrders  Order[]         @relation("HandledOrders")
  stockMovements StockMovement[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id             String          @id @default(uuid())
  name           String
  description    String?
  price          Int
  stock          Int             @default(0)
  prepType       ProductPrepType
  imageUrl       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      temporal.updatedAt()
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  bundleItems    BundleItem[]

  @@index([categoryId])
  @@index([isActive])
  @@check(expression: "stock >= 0", name: "product_stock_non_negative")
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique
  channel         OrderChannel
  status          OrderStatus    @default(CONFIRMED)
  customerName    String
  customerPhone   String?
  pickupSlot      String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus  @default(UNPAID)
  paymentProofUrl String?
  // Jadwal serah terima preorder: tanggal (WIB, "2026-11-24"), lokasi, detail
  // titik temu, dan rentang jam yang dipesan. `pickupSlot` tetap menyimpan
  // label rentang jamnya ("11.00 - 12.00") untuk struk dan integrasi.
  // Semuanya kosong untuk pesanan on-the-spot dan pesanan dari sebelum jadwal ada.
  serviceDate        String?
  handoverLocation   HandoverLocation?
  handoverDetail     String?
  serviceWindowId    String?
  serviceWindow      ServiceWindow?    @relation(fields: [serviceWindowId], references: [id])
  // Pesanan berlokasi OTHER menunggu dicek pengurus; diisi saat diterima.
  locationReviewedAt DateTime?
  cashReceived    Int?
  totalAmount     Int
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       temporal.updatedAt()
  queuedAt        DateTime?
  startedAt       DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  handledById     String?
  handledBy       User?          @relation("HandledOrders", fields: [handledById], references: [id])
  items           OrderItem[]
  bundles         OrderBundle[]
  stockMovements  StockMovement[]
  externalCharges ExternalCharge[]

  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([channel, status])
  @@index([serviceDate])
}

model OrderItem {
  id           String  @id @default(uuid())
  quantity     Int
  // priceAtOrder sebagai snapshot harga pada saat pesanan dibuat
  priceAtOrder Int
  subtotal     Int
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  // Terisi kalau baris ini isi sebuah paket: produknya tetap dicatat per baris
  // supaya stok, dapur, dan pembatalan memakai jalur yang sama dengan menu
  // satuan, tapi harganya 0 — uangnya ada di OrderBundle.
  orderBundleId String?
  orderBundle   OrderBundle? @relation(fields: [orderBundleId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderBundleId])
}

// ==========================================
// PAKET (COMBO)
// ==========================================

// Paket hemat, misalnya "Little Power Combo". Harganya sendiri; stoknya tidak:
// sebuah paket bisa dijual selama setiap isinya masih cukup, dan memesannya
// memotong stok tiap produk di dalamnya.
model Bundle {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Int
  imageUrl     String?
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    temporal.updatedAt()
  items        BundleItem[]
  orderBundles OrderBundle[]

  @@index([isActive])
  @@check(expression: "price >= 0", name: "bundle_price_non_negative")
}

// Satu isi paket: produk apa, berapa porsi.
model BundleItem {
  id        String  @id @default(uuid())
  quantity  Int
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([bundleId, productId])
  @@index([productId])
  @@check(expression: "quantity > 0", name: "bundle_item_quantity_positive")
}

// Paket yang dipesan, dengan nama dan harga saat itu sebagai snapshot —
// seperti priceAtOrder pada OrderItem, supaya paket yang diganti namanya atau
// harganya tidak mengubah nota lama.
model OrderBundle {
  id           String      @id @default(uuid())
  name         String
  quantity     Int
  priceAtOrder Int
  subtotal     Int
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bundleId     String
  bundle       Bundle      @relation(fields: [bundleId], references: [id])
  items        OrderItem[]

  @@index([orderId])
}

// Tagihan dari layanan lain, misalnya cetak foto photobooth (BPB-098,
// keputusan K-05 dan K-13). Sudah lunas saat dicatat: uangnya diterima kru
// layanan itu. Tampil di nota terpisah dari makanan; totalAmount dan item
// makanan tidak pernah diubah. Dibatalkan dengan voidedAt, tidak dihapus,
// supaya tetap ada untuk audit.
model ExternalCharge {
  id          String       @id @default(uuid())
  source      ChargeSource
  // ID dari layanan pengirim (untuk photobooth: ID pesanan cetaknya). Unik,
  // jadi kiriman ulang tidak pernah membuat baris kedua.
  externalId  String       @unique
  description String
  amount      Int
  paidAt      DateTime
  voidedAt    DateTime?
  createdAt   DateTime     @default(now())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model StockMovement {
  id        String      @id @default(uuid())
  // quantity bisa negatif untuk merepresentasikan pengurangan stok
  quantity  Int
  reason    StockReason
  createdAt DateTime    @default(now())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id])
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])

  @@index([productId])
}

model StoreSetting {
  // @id @default(1) untuk memastikan baris tunggal
  id                Int      @id @default(1)
  preorderOpen      Boolean  @default(true)
  boothOpen         Boolean  @default(true)
  lowStockThreshold Int      @default(3)
  qrisImageUrl      String?
  adminWhatsapp     String?
  // Apakah pengunjung baru ditanya "cewek atau cowok?" dan melihat saklar
  // warna di header. Mati: pengunjung baru tetap pink; yang sudah memilih
  // tetap memakai pilihannya (cookie `accent`), hanya tidak bisa menggantinya.
  accentChoiceEnabled Boolean @default(true)
  // Batas pesan untuk tanggal D: jam ini (menit sejak 00.00 WIB) di hari D-1.
  // Bawaan 21.00.
  orderCutoffMinute Int @default(1260)
  updatedAt         temporal.updatedAt()
}

// Gambar yang diunggah lewat aplikasi: QRIS booth (oleh admin) dan bukti bayar
// QRIS (oleh pelanggan). Disimpan di database supaya tidak butuh layanan
// penyimpanan terpisah. Kolom lain cukup menyimpan alamatnya, "/gambar/<id>"
// (`StoreSetting.qrisImageUrl`, `Order.paymentProofUrl`), dan id baru tiap
// unggahan membuat alamat itu aman di-cache selamanya.
model StoredImage {
  id        String          @id @default(uuid())
  kind      StoredImageKind
  mimeType  String
  data      Bytes
  byteSize  Int
  createdAt DateTime        @default(now())

  @@check(expression: "octet_length(data) BETWEEN 1 AND 3145728", name: "stored_image_size_limit")
}

// Tanggal yang dibuka pengurus untuk menangani preorder. Tanggal yang tidak ada
// di sini (atau `isOpen` mati) berarti tidak ada layanan preorder hari itu.
// `locations` berisi nilai HandoverLocation yang dilayani tanggal itu.
model ServiceDay {
  id        String          @id @default(uuid())
  date      String          @unique
  isOpen    Boolean         @default(true)
  locations String[]
  createdAt DateTime        @default(now())
  windows   ServiceWindow[]
}

// Rentang jam serah terima pada satu tanggal layanan, dengan kuotanya sendiri.
// `booked` dinaikkan lewat update bersyarat (booked < quota), seperti slot lama,
// supaya database yang menjaga kuota saat dua pelanggan checkout bersamaan.
model ServiceWindow {
  id          String     @id @default(uuid())
  dayId       String
  day         ServiceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  startMinute Int
  endMinute   Int
  quota       Int
  booked      Int        @default(0)
  orders      Order[]

  @@unique([dayId, startMinute])
  @@index([dayId])
  @@check(expression: "booked >= 0", name: "service_window_booked_non_negative")
  @@check(expression: "booked <= quota", name: "service_window_booked_within_quota")
}

// Slot jam lama (satu hari, tanpa tanggal). Tidak dipakai pesanan baru sejak
// jadwal layanan (ServiceDay/ServiceWindow); dibiarkan untuk pesanan lama.
model PickupSlot {
  id        String  @id @default(uuid())
  // label, contoh "09.00 - 10.00"
  label     String
  quota     Int
  // booked adalah penghitung pesanan aktif di slot ini. Dinaikkan lewat update
  // bersyarat (booked < quota) supaya database yang mengevaluasi kuota, bukan
  // aplikasi — menghitung baris lalu membandingkan bisa kebobolan saat dua
  // pelanggan checkout bersamaan. Diturunkan lagi saat pesanan dibatalkan.
  booked    Int     @default(0)
  sortOrder Int
  isActive  Boolean @default(true)

  @@check(expression: "booked >= 0", name: "pickup_slot_booked_non_negative")
  @@check(expression: "booked <= quota", name: "pickup_slot_booked_within_quota")
}

// ==========================================
// PROFIL USAHA (CMS)
// ==========================================

model SiteText {
  // key menamai satu blok teks yang bisa diedit, contoh "hero.title" atau
  // "story.body". Nilai bawaannya ada di src/lib/site-content.ts, jadi halaman
  // profil tetap tampil utuh di database yang baru — baris di sini hanya
  // menimpa bawaan itu.
  key       String @id
  value     String
  // version dinaikkan setiap kali blok disimpan, dan penyimpanan memakai UPDATE
  // bersyarat pada versi yang dibaca editor. Dua admin yang mengedit blok sama
  // bersamaan tidak saling menimpa tanpa sadar: yang kalah mengenai nol baris
  // dan diberi tahu, bukan diam-diam menghapus tulisan orang lain. Versi 0
  // berarti "belum ada baris", yaitu masih memakai nilai bawaan.
  version   Int    @default(1)
  updatedAt temporal.updatedAt()
}

model SiteListItem {
  id        String  @id @default(uuid())
  // section menentukan daftar mana baris ini milik, sekaligus kolom mana yang
  // dipakai — satu tabel untuk tiga daftar yang bentuknya memang sama (gambar
  // opsional, judul, satu baris keterangan, urutan):
  //   "advantage" -> icon, title, body
  //   "team"      -> title = nama, body = peran, imageUrl = foto
  //   "gallery"   -> imageUrl, title = keterangan
  section   String
  icon      String?
  imageUrl  String?
  title     String
  body      String?
  // sortOrder ditukar antar dua baris saat item digeser naik/turun.
  sortOrder Int
  version   Int     @default(1)
  updatedAt temporal.updatedAt()

  @@index([section, sortOrder])
}
